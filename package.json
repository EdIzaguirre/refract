{
  "name": "refract",
  "version": "0.1.0",
  "description": "See how a code change reshaped a codebase: a zoomable before/after map, live-watching an agent's branch, and design lenses from Metz, Ousterhout and Copeland.",
  "type": "module",
  "bin": {
    "refract": "bin/refract.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "sample": "bash scripts/make-sample-repo.sh"
  },
  "files": [
    "bin",
    "dist",
    "readers",
    "lenses",
    "claude"
  ],
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "elkjs": "^0.9.3",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "private": true
}
